POSTGRES_USER=aml
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aml
POSTGRES_PORT=5433
OPENAI_API_KEY=
SEED=42

# F06 agent graph (all optional; defaults live in app/config.py)
LLM_PLAN_MODEL=gpt-4o-mini
LLM_ASSESS_MODEL=gpt-4o
MAX_TOOL_CALLS=8
CLOSE_RISK_MAX=0.30
CLOSE_CONFIDENCE_MIN=0.80
NO_AUTO_CLOSE_RULES=fan_in,high_risk_counterparty
# F09 long-term memory
MEMORY_HISTORY_LIMIT=5
MEMORY_BLOCK_AUTO_CLOSE_ON_PRIOR_SAR=true

# F07 async execution (all optional; defaults live in app/config.py)
# Leave AWS_ENDPOINT_URL unset on real AWS; docker-compose points it at LocalStack.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=aml-investigations
SQS_DLQ_NAME=aml-investigations-dlq
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT=300
WORKER_CONCURRENCY=4

# F10 Redis (all optional; defaults live in app/config.py; docker-compose points at the redis service)
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2.0
SANCTIONS_CACHE_TTL_SECONDS=3600
LLM_RATE_LIMIT_PER_SECOND=5.0
LLM_RATE_LIMIT_BURST=10
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=60
CASE_LOCK_TTL_SECONDS=300
EVENTS_TTL_SECONDS=3600

# F10.5 console contract (restricted DB role for the separate console + relay)
CONSOLE_DB_PASSWORD=change-me
CONSOLE_RELAY_ENABLED=true
CONSOLE_RELAY_POLL_SECONDS=5
CONSOLE_RELAY_MAX_ATTEMPTS=5

# F12 LLM gateway (all optional; defaults live in app/config.py)
LLM_FALLBACK_PLAN_MODEL=gpt-4o-mini
LLM_FALLBACK_ASSESS_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=20
LLM_CASE_BUDGET_USD=1.0

# F16 load test: LLM_PROVIDER=fake runs the worker on a deterministic stand-in LLM (free)
LLM_PROVIDER=openai
FAKE_LLM_LATENCY_MS=1500
FAKE_LLM_JITTER_MS=0
FAKE_LLM_ERROR_RATE=0.0
FAKE_LLM_ESCALATE_PCT=30

# F13 observability (all optional; defaults live in app/config.py)
# Tracing is on only when LANGSMITH_TRACING=true and LANGSMITH_API_KEY is set; traces are PII-masked.
LOG_FORMAT=text
LOG_LEVEL=INFO
WORKER_METRICS_PORT=0
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aml-investigation-agent

# F04 rules engine thresholds (all optional; defaults live in app/config.py)
RULE_VELOCITY_WINDOW_HOURS=1
RULE_VELOCITY_MIN_TXNS=10
RULE_FAN_WINDOW_HOURS=24
RULE_FAN_MIN_DEGREE=8
RULE_ROUND_TRIP_WINDOW_HOURS=24
RULE_ROUND_TRIP_MAX_HOPS=3
RULE_STRUCTURING_LIMIT=10000
RULE_STRUCTURING_MARGIN=0.10
RULE_STRUCTURING_MIN_TXNS=3
RULE_STRUCTURING_WINDOW_HOURS=24
RULE_HIGH_RISK_COUNTRIES=IR,KP,SY,MM,CU
RULE_HIGH_RISK_RATINGS=high
RULE_HIGH_RISK_WINDOW_HOURS=24
RULE_SANCTIONS_SIMILARITY=0.5
